# This file is used to store environment variables for the application.
# It should not be committed to version control, as it may contain sensitive information.

# API keys for LLMs
# Vite only exposes VITE_-prefixed variables to client code (import.meta.env) —
# this is a no-backend app, so the LLM clients read these directly in the browser.
#
# Data-analysis provider (data dictionary + business insights).
# To create a Mistral API key, visit: https://console.mistral.ai/api-keys
VITE_MISTRAL_API_KEY=<your_mistral_api_key_here>
#Use those preconfigured or choose your own model ID from the list of available models in the Mistral API.
VITE_MISTRAL_MODEL_ID=mistral-large-2512
VITE_MISTRAL_FALLBACK_MODEL_ID=mistral-small-2603

# Report-text provider (client questions).
# To create a Google AI Studio API key, visit: https://aistudio.google.com/app/api-keys
VITE_GOOGLE_API_KEY=<your_google_api_key_here>
#Use those preconfigured or choose your own model ID from the list of available models in the Google AI Studio API.
VITE_GOOGLE_MODEL_ID=gemini-3.5-flash-lite
VITE_GOOGLE_FALLBACK_MODEL_ID=gemini-3.6-flash